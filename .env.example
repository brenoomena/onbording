# Supabase · Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica
# Chave secreta: só no servidor (Vercel > Environment Variables). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# Endereço público da aplicação, usado nos links dos e-mails de convite e de senha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login com Google (opcional). Use "true" depois de configurar o provedor Google no Supabase.
NEXT_PUBLIC_LOGIN_GOOGLE=false
# Domínio de e-mail aceito no login com Google (ex.: implantta.com.br). Vazio = qualquer domínio.
NEXT_PUBLIC_GOOGLE_DOMAIN=implantta.com.br

# Testes de banco: Postgres descartável onde o usuário pode criar bancos.
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
